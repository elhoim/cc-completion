#compdef claude
# Zsh completion script for Claude Code
# Install: place this file in a directory in your $fpath (e.g., /usr/local/share/zsh/site-functions/)

# Built-in tool names accepted by --tools / --allowedTools / --disallowedTools.
# `--help` carries no full listing, so this mirrors the built-in tool set of the
# claude release named in the commit message. Canonical names only -- the older
# aliases (Task, BashOutput, KillShell, ...) still resolve at runtime but are not
# offered here. "default" comes from the --tools help text ('Use "" to disable
# all tools, "default" to use all tools').
_claude_tools() {
    compadd -- Bash PowerShell REPL \
        Read Write Edit NotebookEdit Glob Grep LSP \
        WebFetch WebSearch \
        Agent ListAgents Skill SendMessage Workflow ToolSearch \
        TaskCreate TaskGet TaskList TaskOutput TaskStop TaskUpdate \
        Monitor CronCreate CronDelete CronList ScheduleWakeup RemoteTrigger PushNotification ReadNotifications Poll \
        EnterWorktree ExitWorktree \
        TodoWrite AskUserQuestion EnterPlanMode ExitPlanMode ReportFindings ProposeGoal \
        ListMcpResourcesTool ReadMcpResourceTool ReadMcpResourceDirTool RefreshMcpTools \
        SearchMcpRegistry WaitForMcpServers ListConnectors SuggestConnectors \
        Artifact ArtifactCheck ArtifactComments ArtifactData ClaudeDesign DesignSync Projects \
        SendUserFile SendFile SendFeedback SendUserMessage EndConversation \
        ObserverReport StructuredOutput TestingPermission \
        ShareOnboardingGuide ShowOnboardingRolePicker SuggestPluginInstall SuggestSkills \
        default
}

_claude() {
    local -a commands global_opts output_formats input_formats permission_modes models setting_sources

    commands=(
        'agents:Manage background agents'
        'attach:Open a background session in this terminal'
        'logs:Print the recent terminal output of a background session'
        'stop:Stop a background session, keeping its conversation'
        'kill:Stop a background session, keeping its conversation'
        'rm:Delete a background session, and its worktree when that is safe'
        'respawn:Restart a background session so it runs the current Claude Code version'
        'auth:Manage authentication'
        'mcp:Configure and manage MCP servers'
        'plugin:Manage Claude Code plugins'
        'plugins:Manage Claude Code plugins'
        'project:Manage Claude Code project state'
        'setup-token:Set up a long-lived authentication token'
        'doctor:Check the health of your Claude Code installation'
        'gateway:Run the enterprise auth/telemetry gateway'
        'import:Import config from another AI coding agent into Claude Code'
        'update:Check for updates and install if available'
        'upgrade:Check for updates and install if available'
        'auto-mode:Inspect or reset auto mode classifier configuration'
        'install:Install Claude Code native build'
        'ultrareview:Run a cloud-hosted multi-agent code review of the current branch'
    )

    global_opts=(
        {-d,--debug}'[Enable debug mode with optional category filtering]::filter:'
        '--debug-file[Write debug logs to a specific file path]:path:_files'
        '--verbose[Override verbose mode setting from config]'
        {-p,--print}'[Print response and exit]'
        '--output-format[Output format]:format:(text json stream-json)'
        '--json-schema[JSON Schema for structured output validation]:schema:'
        '--include-hook-events[Include all hook lifecycle events in the output stream]'
        '--include-partial-messages[Include partial message chunks]'
        '--forward-subagent-text[Forward subagent text and thinking blocks as assistant/user messages]'
        '--input-format[Input format]:format:(text stream-json)'
        '--dangerously-skip-permissions[Bypass all permission checks]'
        '--allow-dangerously-skip-permissions[Enable bypassing permission checks as an option]'
        '--max-budget-usd[Maximum dollar amount to spend]:amount:'
        '--replay-user-messages[Re-emit user messages from stdin]'
        '*--allowedTools[Comma or space-separated list of tool names to allow]:tools:_claude_tools'
        '*--allowed-tools[Comma or space-separated list of tool names to allow]:tools:_claude_tools'
        '*--tools[Specify the list of available tools]:tools:_claude_tools'
        '*--disallowedTools[Comma or space-separated list of tool names to deny]:tools:_claude_tools'
        '*--disallowed-tools[Comma or space-separated list of tool names to deny]:tools:_claude_tools'
        '*--mcp-config[Load MCP servers from JSON files or strings]:configs:_files'
        '--system-prompt[System prompt to use for the session]:prompt:'
        '--append-system-prompt[Append a system prompt]:prompt:'
        '--system-prompt-snapshot[Record the system prompt once per conversation and reuse it verbatim on every request and resume (recommended: on)]:mode:(on off)'
        '--exclude-dynamic-system-prompt-sections[Move per-machine sections to first user message for prompt-cache reuse (default system prompt only)]'
        '--permission-mode[Permission mode to use]:mode:(acceptEdits bypassPermissions manual dontAsk plan auto)'
        '--permission-prompts[Who answers permission prompts with --print]:target:(host none)'
        {-c,--continue}'[Continue the most recent conversation]'
        {-r,--resume}'[Resume a conversation by session ID]::session:'
        '--fork-session[Create a new session ID when resuming]'
        '--no-session-persistence[Disable session persistence]'
        '--model[Model for the current session]:model:(sonnet opus haiku fable best sonnet\[1m\] opus\[1m\] fable\[1m\] opusplan)'
        '--agent[Agent for the current session]:agent:'
        '*--betas[Beta headers to include in API requests]:betas:'
        '--fallback-model[Enable automatic fallback to specified model]:model:(sonnet opus haiku fable best sonnet\[1m\] opus\[1m\] fable\[1m\] opusplan)'
        '--settings[Path to a settings JSON file or JSON string]:file:_files'
        '*--add-dir[Additional directories to allow tool access]:directories:_files -/'
        '*--file[File resources to download at startup]:specs:'
        '--ide[Automatically connect to IDE on startup]'
        '--strict-mcp-config[Only use MCP servers from --mcp-config]'
        '--session-id[Use a specific session ID]:uuid:'
        '--agents[JSON object defining custom agents]:json:'
        '--setting-sources[Comma-separated list of setting sources]:sources:(user project local)'
        '*--plugin-dir[Load a plugin from a directory or .zip]:paths:_files'
        '*--plugin-url[Fetch a plugin .zip from a URL for this session only]:url:'
        '--disable-slash-commands[Disable all skills]'
        '--chrome[Enable Claude in Chrome integration]'
        '--no-chrome[Disable Claude in Chrome integration]'
        '--remote-control[Start an interactive session with Remote Control enabled (optionally named)]::name:'
        '--remote-control-session-name-prefix[Prefix for auto-generated Remote Control session names]:prefix:'
        '--from-pr[Resume session associated with a PR]::pr:'
        {-w,--worktree}'[Create a git worktree and start session]::name:'
        '--cloud[Create a cloud session with the given description, or attach to an existing one by session ID or claude.ai/code URL]::description:'
        '--environment[Create a new cloud session that runs on the given self-hosted environment (ccpool_...)]:environment_id:'
        '--teleport[Resume a teleport session, optionally specify session ID]::session:'
        '--tmux[Create a tmux session for worktree]'
        '--ax-screen-reader[Render screen-reader friendly output (flat text, no decorative borders or animations)]'
        '--bare[Minimal mode: skip hooks, LSP, and auto-discovery]'
        '--safe-mode[Start with all customizations disabled — useful for troubleshooting]'
        '--restricted[Restricted mode: drop the code-running tools and WebFetch, ignore user/project/local settings, confine file tools to the working directories]'
        '--brief[Enable SendUserMessage tool for agent-to-user communication]'
        '--prompt-suggestions[Enable prompt suggestions]::enabled:(true false 1 0 yes no on off)'
        '--autocompact[Auto-compact window size (auto, or 100k-1M tokens)]:window:->autocompact'
        '--effort[Effort level for the current session]:level:->effort'
        {-n,--name}'[Name for the conversation]:name:'
        {--bg,--background}'[Start the session as a background agent]'
        {-v,--version}'[Output the version number]'
        {-h,--help}'[Display help for command]'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args' \
        $global_opts

    case $state in
        command)
            _describe -t commands 'claude command' commands
            ;;
        effort)
            compadd -V effort -- low medium high xhigh max
            ;;
        # Any value in the documented 100k-1M range parses (500k / 200000 / 200
        # shorthand), so these are round-number hints, not a closed choice list.
        autocompact)
            compadd -V autocompact -- auto 100k 200k 500k 1m
            ;;
        args)
            case $words[1] in
                agents)
                    # Note: for an option that also exists in $global_opts, the
                    # outer `_arguments -C ... $global_opts` above drives value
                    # completion -- the action written here never runs (only the
                    # description, which is what `claude agents -` lists). Keep
                    # the two in sync so this spec does not claim a shape the
                    # user will not actually get.
                    _arguments \
                        '*--add-dir[Additional directory to allow tool access in dispatched sessions]:directory:_files -/' \
                        '--agent[Default agent for sessions dispatched from agent view]:agent:' \
                        '--all[With --json: also include completed background sessions]' \
                        '--allow-dangerously-skip-permissions[Make bypass-permissions mode available to dispatched sessions]' \
                        '--cwd[Show only background sessions started under path]:path:_files -/' \
                        '--dangerously-skip-permissions[Alias for --permission-mode bypassPermissions]' \
                        '--effort[Default effort level for dispatched sessions]:level:(low medium high xhigh max)' \
                        '--json[Print active sessions (interactive and background) as a JSON array and exit (for scripting; does not require a TTY)]' \
                        '*--mcp-config[MCP server configuration to apply to dispatched sessions]:config:_files' \
                        '--model[Default model for dispatched sessions]:model:(sonnet opus haiku fable best sonnet\[1m\] opus\[1m\] fable\[1m\] opusplan)' \
                        '--permission-mode[Default permission mode for dispatched sessions]:mode:(acceptEdits bypassPermissions manual dontAsk plan auto)' \
                        '*--plugin-dir[Load plugins from specified directory for dispatched sessions]:path:_files' \
                        '--restricted[Start dispatched sessions in restricted mode]' \
                        '--setting-sources[Comma-separated list of setting sources]:sources:(user project local)' \
                        '--settings[Settings file or JSON string to apply]:file:_files' \
                        '--strict-mcp-config[Only use MCP servers from --mcp-config in dispatched sessions]' \
                        {-h,--help}'[Display help for command]'
                    ;;
                # Background session commands. Their `--help` is a hand-written
                # usage line with no `Options:` section, so the only flags any of
                # them documents are the ones that usage line spells out
                # (`respawn --all`, `rm --discard-unpushed`). <id> is the short id
                # `claude --bg` prints -- runtime state, so no action here.
                attach|logs|stop|kill)
                    _arguments '1:session id:'
                    ;;
                rm)
                    # The value is a `<commit>@<worktree-id>` echoed by an earlier
                    # `claude rm <id>`, so there is nothing to offer for it.
                    _arguments \
                        "--discard-unpushed[Also discard the worktree's unpushed commits and uncommitted changes]:commit@worktree-id:" \
                        '1:session id:'
                    ;;
                respawn)
                    _arguments \
                        '--all[Restart every background session]' \
                        '1:session id:'
                    ;;
                auth)
                    local -a auth_commands
                    auth_commands=(
                        'login:Sign in to your Anthropic account'
                        'logout:Log out from your Anthropic account'
                        'status:Show authentication status'
                    )
                    _arguments -C \
                        {-h,--help}'[Display help for command]' \
                        '1: :->auth_cmd' \
                        '*:: :->auth_args'
                    case $state in
                        auth_cmd)
                            _describe -t commands 'auth command' auth_commands
                            ;;
                        auth_args)
                            case $words[1] in
                                login)
                                    _arguments \
                                        '--claudeai[Use Claude subscription (default)]' \
                                        '--console[Use Anthropic Console (API usage billing)]' \
                                        '--email[Pre-populate email address on the login page]:email:' \
                                        '--sso[Force SSO login flow]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                logout)
                                    _arguments \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                status)
                                    _arguments \
                                        '--json[Output as JSON (default)]' \
                                        '--text[Output as human-readable text]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                            esac
                            ;;
                    esac
                    ;;
                mcp)
                    local -a mcp_commands
                    mcp_commands=(
                        'add:Add an MCP server to Claude Code'
                        'add-from-claude-desktop:Import MCP servers from Claude Desktop'
                        'add-json:Add an MCP server with a JSON string'
                        'get:Get details about an MCP server'
                        'list:List configured MCP servers'
                        'remove:Remove an MCP server'
                        'reset-project-choices:Reset all approved and rejected project-scoped servers'
                        'serve:Start the Claude Code MCP server'
                        'login:Authenticate with an MCP server'
                        'logout:Clear stored OAuth credentials for an MCP server'
                    )
                    _arguments -C \
                        {-h,--help}'[Display help for command]' \
                        '1: :->mcp_cmd' \
                        '*:: :->mcp_args'
                    case $state in
                        mcp_cmd)
                            _describe -t commands 'mcp command' mcp_commands
                            ;;
                        mcp_args)
                            case $words[1] in
                                add)
                                    _arguments \
                                        {-s,--scope}'[Configuration scope]:scope:(local user project)' \
                                        {-t,--transport}'[Transport type]:transport:(stdio sse http)' \
                                        {-e,--env}'[Set environment variables]:env:' \
                                        {-H,--header}'[Set WebSocket headers]:header:' \
                                        '--callback-port[Fixed port for OAuth callback]:port:' \
                                        '--client-id[OAuth client ID]:clientId:' \
                                        '--client-secret[Prompt for OAuth client secret]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                add-from-claude-desktop)
                                    _arguments \
                                        {-s,--scope}'[Configuration scope]:scope:(local user project)' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                add-json)
                                    _arguments \
                                        {-s,--scope}'[Configuration scope]:scope:(local user project)' \
                                        '--client-secret[Prompt for OAuth client secret]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                get)
                                    _arguments \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                remove)
                                    _arguments \
                                        {-s,--scope}'[Configuration scope]:scope:(local user project)' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                list)
                                    _arguments \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                reset-project-choices)
                                    _arguments \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                serve)
                                    _arguments \
                                        {-d,--debug}'[Enable debug mode]' \
                                        '--verbose[Override verbose mode setting from config]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                login)
                                    _arguments \
                                        '--no-browser[Print the authorization URL instead of opening a browser]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                logout)
                                    _arguments \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                            esac
                            ;;
                    esac
                    ;;
                plugin|plugins)
                    local -a plugin_commands
                    plugin_commands=(
                        'details:Show a plugin'\''s component inventory and projected token cost'
                        'disable:Disable an enabled plugin'
                        'enable:Enable a disabled plugin'
                        'eval:Run eval cases against a plugin and report scored results'
                        'init:Scaffold a new plugin'
                        'new:Scaffold a new plugin (alias for init)'
                        'install:Install a plugin from available marketplaces'
                        'i:Install a plugin (alias for install)'
                        'list:List installed plugins'
                        'marketplace:Manage Claude Code marketplaces'
                        'prune:Remove auto-installed dependencies that are no longer needed'
                        'autoremove:Remove auto-installed dependencies (alias for prune)'
                        'tag:Create a {name}--v{version} git tag for a plugin release'
                        'uninstall:Uninstall an installed plugin'
                        'remove:Uninstall an installed plugin (alias for uninstall)'
                        'update:Update a plugin to the latest version'
                        'validate:Validate a plugin or marketplace manifest'
                    )
                    _arguments -C \
                        {-h,--help}'[Display help for command]' \
                        '1: :->plugin_cmd' \
                        '*:: :->plugin_args'
                    case $state in
                        plugin_cmd)
                            _describe -t commands 'plugin command' plugin_commands
                            ;;
                        plugin_args)
                            case $words[1] in
                                marketplace)
                                    local -a mp_commands
                                    mp_commands=(
                                        'add:Add a marketplace from a URL, path, or GitHub repo'
                                        'list:List all configured marketplaces'
                                        'remove:Remove a configured marketplace'
                                        'rm:Remove a configured marketplace (alias for remove)'
                                        'update:Update marketplace(s) from their source'
                                    )
                                    _arguments -C \
                                        {-h,--help}'[Display help for command]' \
                                        '1: :->mp_cmd' \
                                        '*:: :->mp_args'
                                    case $state in
                                        mp_cmd)
                                            _describe -t commands 'marketplace command' mp_commands
                                            ;;
                                        mp_args)
                                            case $words[1] in
                                                add)
                                                    _arguments \
                                                        '--scope[Where to declare the marketplace]:scope:(user project local)' \
                                                        '--sparse[Limit checkout to specific directories via git sparse-checkout]:paths:' \
                                                        {-h,--help}'[Display help for command]'
                                                    ;;
                                                list)
                                                    _arguments \
                                                        '--json[Output as JSON]' \
                                                        {-h,--help}'[Display help for command]'
                                                    ;;
                                                remove|rm)
                                                    _arguments \
                                                        '--scope[Remove the marketplace from a specific scope]:scope:(user project local)' \
                                                        {-h,--help}'[Display help for command]'
                                                    ;;
                                                *)
                                                    _arguments \
                                                        {-h,--help}'[Display help for command]'
                                                    ;;
                                            esac
                                            ;;
                                    esac
                                    ;;
                                eval)
                                    local -a eval_commands
                                    eval_commands=(
                                        'init:Author an eval suite under the eval dir via an interview'
                                    )
                                    local -a eval_opts
                                    eval_opts=(
                                        '--ablation[Run a no-plugin baseline arm and report the score delta]:mode:(none with-without)'
                                        '*--allow-tools[Operator grant for gated tools]:tools:_claude_tools'
                                        '--case[Filter cases by name glob]:glob:'
                                        '--eval-dir[Directory (below the plugin) that holds the eval cases]:dir:_files -/'
                                        '--json[Print the full run result as JSON to stdout, or write it to this .json file]::path:_files'
                                        '--judge-model[Override LLM-grader model]:model:(sonnet opus haiku fable best sonnet\[1m\] opus\[1m\] fable\[1m\] opusplan)'
                                        '--keep-temp[Preserve scaffold dirs for debugging]'
                                        '--max-cost-usd[Optional hard cost ceiling]:usd:'
                                        '--mocks[Mock stand-ins for MCP servers, from the eval dir mocks/]:mode:(record off)'
                                        '--model[Override model for all cases]:model:(sonnet opus haiku fable best sonnet\[1m\] opus\[1m\] fable\[1m\] opusplan)'
                                        '--no-publish[Keep the HTML report local only; skip publishing it to claude.ai]'
                                        '--no-scaffold[Explicitly skip scaffold_script]'
                                        '--output-dir[Directory for aggregate-result.json]:dir:_files -/'
                                        '--publish-report[Also require publishing the report to claude.ai (already the default)]'
                                        '--report[Write a self-contained HTML report]:path:_files'
                                        '--runs[Override per-case runs]:n:'
                                        '--scaffold[Run each case'\''s scaffold_script]'
                                        '*--tag[Filter cases by tag (repeatable)]:tag:'
                                        '--threshold[Exit 1 if any case score is below this threshold]:threshold:'
                                        '--verbose[Log per-message trace events to the debug log]'
                                        {-h,--help}'[Display help for command]'
                                    )
                                    _arguments -C \
                                        $eval_opts \
                                        '1: :->eval_cmd' \
                                        '*:: :->eval_args'
                                    case $state in
                                        eval_cmd)
                                            _describe -t commands 'eval command' eval_commands
                                            ;;
                                        eval_args)
                                            case $words[1] in
                                                init)
                                                    _arguments \
                                                        '--bare[Write a blank template instead of running the interview]' \
                                                        '--eval-dir[Directory to write cases into]:dir:_files -/' \
                                                        {-i,--interactive}'[Run the authoring interview (already the default in a terminal)]' \
                                                        {-h,--help}'[Display help for command]' \
                                                        '1:name:'
                                                    ;;
                                                *)
                                                    # The first positional was a target (path / plugin name /
                                                    # plugin@marketplace), not the `init` subcommand: keep
                                                    # offering eval's own options after it.
                                                    _arguments $eval_opts
                                                    ;;
                                            esac
                                            ;;
                                    esac
                                    ;;
                                details)
                                    _arguments \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                validate)
                                    _arguments \
                                        '--json[Output the validation report as JSON (same exit codes)]' \
                                        '--strict[Treat warnings as errors (exit 1)]' \
                                        {-h,--help}'[Display help for command]' \
                                        '1:path:_files'
                                    ;;
                                tag)
                                    _arguments \
                                        '--dry-run[Print what would be tagged without creating it]' \
                                        {-f,--force}'[Skip the dirty-working-tree and tag-already-exists checks]' \
                                        {-m,--message}'[Tag annotation message (use %s for the version)]:msg:' \
                                        '--push[Push the tag to --remote after creating it]' \
                                        '--remote[Remote to push to with --push]:remote:' \
                                        {-h,--help}'[Display help for command]' \
                                        '1:path:_files -/'
                                    ;;
                                install|i)
                                    _arguments \
                                        '--config[Set a userConfig option from the plugin manifest (repeatable)]:key=value:' \
                                        {-s,--scope}'[Installation scope]:scope:(user project local)' \
                                        {-y,--yes}'[Accept the displayed marketplace-declared command (install or headersHelper) without the confirmation prompt]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                init|new)
                                    _arguments \
                                        '--author[Author name (default: git config user.name)]:name:' \
                                        '--author-email[Author email (default: git config user.email)]:email:' \
                                        '--description[Manifest description]:text:' \
                                        {-f,--force}'[Overwrite an existing .claude-plugin/ at the target]' \
                                        '*--with[Also scaffold components]:component:(skills agents hooks mcp lsp output-style channel)' \
                                        {-h,--help}'[Display help for command]' \
                                        '1:name:'
                                    ;;
                                list)
                                    _arguments \
                                        '--available[Include available plugins from marketplaces (requires --json)]' \
                                        '--json[Output as JSON]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                disable)
                                    _arguments \
                                        {-a,--all}'[Disable all enabled plugins]' \
                                        {-s,--scope}'[Installation scope]:scope:(user project local)' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                enable)
                                    _arguments \
                                        {-s,--scope}'[Installation scope]:scope:(user project local)' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                uninstall|remove)
                                    _arguments \
                                        '--keep-data[Preserve plugin persistent data]' \
                                        '--prune[Also remove auto-installed dependencies that are no longer needed]' \
                                        {-s,--scope}'[Uninstall from scope]:scope:(user project local)' \
                                        {-y,--yes}'[Skip the --prune confirmation prompt]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                prune|autoremove)
                                    _arguments \
                                        '--dry-run[List what would be removed without removing]' \
                                        {-s,--scope}'[Prune at scope]:scope:(user project local)' \
                                        {-y,--yes}'[Skip the confirmation prompt]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                update)
                                    _arguments \
                                        {-s,--scope}'[Installation scope]:scope:(user project local managed)' \
                                        {-y,--yes}'[Accept the displayed marketplace-declared command (changed install or headersHelper) without the confirmation prompt]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                *)
                                    _arguments \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                            esac
                            ;;
                    esac
                    ;;
                project)
                    local -a project_commands
                    project_commands=(
                        'purge:Delete all Claude Code state for a project'
                    )
                    _arguments -C \
                        {-h,--help}'[Display help for command]' \
                        '1: :->project_cmd' \
                        '*:: :->project_args'
                    case $state in
                        project_cmd)
                            _describe -t commands 'project command' project_commands
                            ;;
                        project_args)
                            case $words[1] in
                                purge)
                                    _arguments \
                                        '--all[Purge state for every project]' \
                                        '--dry-run[List what would be deleted without deleting]' \
                                        {-i,--interactive}'[Prompt for each item before deleting]' \
                                        {-y,--yes}'[Skip confirmation prompt]' \
                                        {-h,--help}'[Display help for command]' \
                                        '*: :_files -/'
                                    ;;
                            esac
                            ;;
                    esac
                    ;;
                setup-token)
                    _arguments \
                        {-h,--help}'[Display help for command]'
                    ;;
                auto-mode)
                    local -a automode_commands
                    automode_commands=(
                        'config:Print the effective auto mode config as JSON'
                        'critique:Get AI feedback on your custom auto mode rules'
                        'defaults:Print the default auto mode environment, allow, soft_deny, and hard_deny rules as JSON'
                        'reset:Reset auto mode configuration to the shipped defaults'
                    )
                    _arguments -C \
                        {-h,--help}'[Display help for command]' \
                        '1: :->automode_cmd' \
                        '*:: :->automode_args'
                    case $state in
                        automode_cmd)
                            _describe -t commands 'auto-mode command' automode_commands
                            ;;
                        automode_args)
                            case $words[1] in
                                critique)
                                    _arguments \
                                        '--model[Model for the critique]:model:(sonnet opus haiku fable best sonnet\[1m\] opus\[1m\] fable\[1m\] opusplan)' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                defaults)
                                    _arguments \
                                        '--label[Show only rules whose label starts with this prefix]:prefix:' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                config)
                                    _arguments \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                                reset)
                                    _arguments \
                                        {-y,--yes}'[Skip the confirmation prompt]' \
                                        {-h,--help}'[Display help for command]'
                                    ;;
                            esac
                            ;;
                    esac
                    ;;
                doctor)
                    _arguments \
                        {-h,--help}'[Display help for command]'
                    ;;
                gateway)
                    _arguments \
                        '--config[Path to gateway YAML config]:config:_files' \
                        {-h,--help}'[Display help for command]'
                    ;;
                update|upgrade)
                    _arguments \
                        {-h,--help}'[Display help for command]'
                    ;;
                import)
                    _arguments \
                        '--dry-run[Show what would be imported without writing anything]' \
                        '--yes[Skip the interactive picker]' \
                        {-h,--help}'[Display help for command]' \
                        '1: :(codex gemini)'
                    ;;
                install)
                    _arguments \
                        '--force[Force installation even if already installed]' \
                        {-h,--help}'[Display help for command]' \
                        '1: :(stable latest)'
                    ;;
                ultrareview)
                    _arguments \
                        '--json[Print the raw bugs.json payload instead of formatted findings]' \
                        '--no-post[Do not post the findings to the PR (the default)]' \
                        '--post[Post the finished review'\''s findings to the PR as you (PR targets only)]' \
                        '--timeout[Maximum minutes to wait for the review to finish]:minutes:' \
                        {-h,--help}'[Display help for command]'
                    ;;
            esac
            ;;
    esac
}

_claude "$@"

# Support common alias 'cc'
compdef _claude cc
